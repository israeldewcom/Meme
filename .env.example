NODE_ENV=production
PORT=4000
API_VERSION=v1
LOG_LEVEL=info
TRUST_PROXY=1

# true: seeds demo content and serves labelled simulated data when providers fail.
# false (production): never fabricates market/holder data; returns 503 instead.
DEMO_MODE=false

PUBLIC_SITE_URL=https://yourdomain.com
# Comma separated. Empty = no cross-origin access (same-origin only).
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# docker compose passwords (compose substitutes these into the services)
MONGO_ROOT_USER=mlp
MONGO_ROOT_PASSWORD=CHANGE_ME_MONGO_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Keep these consistent with the passwords above
MONGODB_URI=mongodb://mlp:CHANGE_ME_MONGO_PASSWORD@mongo:27017/meme_launchpad_pro?authSource=admin
MONGODB_DB=meme_launchpad_pro
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379

# Generate: openssl rand -hex 48   (must differ; app refuses to boot in production with CHANGE_ME values)
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_48
JWT_REFRESH_SECRET=CHANGE_ME_generate_a_different_one_openssl_rand_hex_48
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_WALLET_CHALLENGE_TTL=5m

# Use a private RPC (Helius/Triton/QuickNode) in production: public RPC blocks getTokenLargestAccounts
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_NETWORK=mainnet-beta
SOLANA_COMMITMENT=confirmed
BIRDEYE_API_KEY=
DEXSCREENER_API_URL=https://api.dexscreener.com

UPLOAD_PROVIDER=local
LOCAL_UPLOAD_DIR=./public/uploads
LOCAL_UPLOAD_PUBLIC_URL=/uploads
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
UPLOAD_MAX_MB=8
UPLOAD_ALLOWED_MIME=image/png,image/jpeg,image/webp
UPLOAD_IMAGE_MAX_WIDTH=2048

TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=true

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180
AUTH_RATE_LIMIT_MAX=20
REFERRAL_TRACK_MAX=60

WORKER_CONCURRENCY=5
PRICE_REFRESH_INTERVAL_MS=30000
HOLDER_SNAPSHOT_INTERVAL_MS=300000
MARKET_HISTORY_INTERVAL_MS=120000
CLEANUP_INTERVAL_MS=3600000
ENABLE_TELEGRAM_WORKER=true
ENABLE_PRICE_WORKER=true
ENABLE_HOLDER_WORKER=true
ENABLE_HISTORY_WORKER=true
ENABLE_CLEANUP_WORKER=true

# Used by `npm run seed` only
BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_use_12plus_chars
BOOTSTRAP_TENANT_SLUG=demo
BOOTSTRAP_TENANT_NAME=Meme Launchpad Pro
