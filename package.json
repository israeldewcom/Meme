{
  "name": "meme-launchpad-pro",
  "version": "2.1.0",
  "description": "Multi-tenant meme token launchpad - production backend",
  "main": "dist/server.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/server.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only --exit-child src/workers/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "start:worker": "node dist/workers/index.js",
    "seed": "node dist/scripts/seed.js",
    "seed:dev": "ts-node-dev --transpile-only --exit-child src/scripts/seed.ts",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.678.0",
    "@solana/web3.js": "^1.95.4",
    "argon2": "^0.41.1",
    "axios": "^1.7.7",
    "bs58": "^5.0.0",
    "bullmq": "^5.28.2",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0",
    "multer": "^2.0.2",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "rate-limit-redis": "^4.2.0",
    "sharp": "^0.33.5",
    "tweetnacl": "^1.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "pino-pretty": "^11.3.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
